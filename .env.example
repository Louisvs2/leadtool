# ---------------------------------------------------------------------------
# CULTTWENTY OUTBOUND — environment variables
# Copy this file to .env (local dev) and configure your secrets there.
# See README.md "Setup" section for full details on every variable.
# ---------------------------------------------------------------------------

# --- Database -----------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/culttwenty_outbound"
# Direct (non-pooled) connection, used for schema pushes. On a provider with
# connection pooling (e.g. Neon: DATABASE_URL = the "pooled" string, this =
# the "direct" string), these two differ. Otherwise just set both the same.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/culttwenty_outbound"

# --- Auth -----------------------------------------------------------------
# Random 32+ char secret used to sign session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
# Base URL of the deployed app (used for callback/redirect resolution).
AUTH_URL="http://localhost:3000"

# Seed admin account (used once by `npm run db:seed` to create the first user).
ADMIN_EMAIL="admin@culttwenty.de"
ADMIN_PASSWORD="change-me-now"

# --- AI (OpenAI) ------------------------------------------------------------
# Optional. Without a key the app runs fully in AI Mock Mode: research
# summaries, scoring rationale and email copy are produced by deterministic,
# clearly-labelled template logic instead of live model calls, so the whole
# workflow stays testable without any external cost.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"

# --- Email sending ----------------------------------------------------------
# Which provider to actually use for sending. One of: mock | resend | sendgrid | smtp
# "mock" (default) logs emails to the database/console instead of sending —
# safe for local dev and demos.
EMAIL_PROVIDER="mock"

RESEND_API_KEY=""

SENDGRID_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"

# Inbound reply webhook shared secret (verifies requests from your email
# provider's inbound-parse webhook before creating Reply records).
INBOUND_WEBHOOK_SECRET="replace-with-a-long-random-string"

# --- Lead discovery ----------------------------------------------------------
# Optional. Without a key, "Find Leads" uses the built-in Demo discovery
# provider (clearly labelled demo companies) so the full pipeline can be
# exercised without a paid data source. Wire up a real provider by
# implementing `src/lib/discovery/providers/*` against your data vendor
# of choice (e.g. a company-search API you are licensed to use) and
# setting LEAD_DISCOVERY_PROVIDER=custom.
LEAD_DISCOVERY_PROVIDER="demo"

# --- Background processing ---------------------------------------------
# Shared secret for /api/cron/process, the endpoint that dispatches due
# queued emails and follow-ups. Wire a scheduled trigger (see
# .github/workflows/cron.yml) to POST this route every few minutes with
# header "Authorization: Bearer <CRON_SECRET>". Required in production; if
# unset, the endpoint refuses all requests rather than running
# unauthenticated.
CRON_SECRET="replace-with-a-long-random-string"

# NOTE: everything below "Auth" except DATABASE_URL/DIRECT_URL/AUTH_SECRET
# can also be set from the running app itself (Settings -> API Keys) once
# you've logged in — that's the easier path for day-to-day use. These env
# vars are only needed if you'd rather configure them before first login,
# or are running the app somewhere config-as-env is more convenient.
